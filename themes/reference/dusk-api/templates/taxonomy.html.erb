<section class="theme-dusk" data-theme="dusk"><h1><%= theme.archive_title %></h1><% if theme.family == "search" %><form action="/search" method="get"><label for="theme-query">Search</label><input id="theme-query" name="q" value="<%= theme.query %>"><button>Search</button></form><% end %><% theme.items.each do |item| %><article><h2><a href="<%= item.url %>"><%= item.title %></a></h2><p><%= item.excerpt %></p></article><% end %><%= theme_component "pagination" %></section>
