<article class="theme-dusk palette-<%= theme.options["palette"] %> font-<%= theme.options["font"] %> layout-<%= theme.options["layout"] %> home-<%= theme.options["home_pattern"] %>" data-theme="dusk"><% if theme.content %><h1><%= theme.content.title %></h1><%= theme_component "media" %><%= theme.content.body_html %><%= theme.content.blocks_html %><% else %><h1><%= theme.site.title %></h1><p>No published page yet.</p><% end %></article>
