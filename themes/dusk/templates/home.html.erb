<div class="dusk-shell dusk-palette-<%= theme.options.fetch("palette", "afterglow") %> dusk-font-<%= theme.options.fetch("font", "system_serif") %> dusk-layout-<%= theme.options.fetch("layout", "studio") %>" data-dusk-family="home"><section class="dusk-wrap dusk-welcome<%= " dusk-illustrated-heading" if theme_artwork? %>"><div><p class="dusk-kicker">A space for what matters</p><h1><%= theme.site.title %></h1><p class="dusk-lede"><%= theme.site.tagline %></p><p>Welcome. This site is taking shape.</p><a class="dusk-button" href="<%= theme.site.blog_url %>">Explore the journal <span aria-hidden="true">↗</span></a></div><% if theme_artwork? %><%= theme_picture "hero", loading: "eager", sizes: "(min-width: 58rem) 40vw, 100vw" %><% else %><span class="dusk-horizon" aria-hidden="true"></span><% end %></section><% if theme_artwork? && theme.recent_items.empty? %><div class="dusk-wrap dusk-art-pair" aria-hidden="true"><%= theme_picture "rhythm" %><%= theme_picture "appearance" %></div><% end %><div class="dusk-wrap"><% if theme.options.fetch("home_pattern", "journal") == "journal" && theme.recent_items.any? %><section class="dusk-recent" aria-labelledby="dusk-recent-title"><div class="dusk-section-heading"><div><p class="dusk-kicker">Notes & perspectives</p><h2 id="dusk-recent-title">From the journal</h2></div><a class="dusk-text-link" href="<%= theme.site.blog_url %>">All stories <span aria-hidden="true">↗</span></a></div><div class="dusk-cards"><% theme.recent_items.each_with_index do |item, index| %><article class="dusk-card"><% if theme_artwork? %><%= theme_picture %w[publishing customization foundation][index % 3], sizes: "(min-width: 58rem) 24vw, 100vw" %><% end %><% if item.published_at %><p class="dusk-kicker"><time datetime="<%= item.published_at %>"><%= item.published_at[0, 10] %></time></p><% end %><h3><a href="<%= item.url %>"><%= item.title %></a></h3><p><%= item.excerpt %></p></article><% end %></div></section><% end %></div></div>
