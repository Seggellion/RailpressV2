<div class="dusk-shell dusk-palette-<%= theme.options.fetch("palette", "afterglow") %> dusk-font-<%= theme.options.fetch("font", "system_serif") %> dusk-layout-<%= theme.options.fetch("layout", "studio") %>" data-dusk-family="front"><article class="dusk-wrap dusk-front"><header class="dusk-front-heading<%= " dusk-illustrated-heading" if theme_artwork? && theme.content.featured_html.to_s.empty? %>"><div><p class="dusk-kicker"><%= theme.site.tagline %></p><h1><%= theme.content.title %></h1><% if theme.content.excerpt.to_s.length > 0 %><p class="dusk-lede"><%= theme.content.excerpt %></p><% end %></div><% if theme_artwork? && theme.content.featured_html.to_s.empty? %><%= theme_picture "hero", loading: "eager", sizes: "(min-width: 58rem) 40vw, 100vw" %><% elsif !theme_artwork? %><span class="dusk-horizon" aria-hidden="true"></span><% end %></header><%= theme_component "media" %><div class="dusk-prose dusk-patterns"><%= theme.content.body_html %><%= theme.content.blocks_html %></div></article><div class="dusk-wrap"><% if theme.options.fetch("home_pattern", "journal") == "journal" && theme.recent_items.any? %><section class="dusk-recent" aria-labelledby="dusk-recent-title"><div class="dusk-section-heading"><div><p class="dusk-kicker">Notes & perspectives</p><h2 id="dusk-recent-title">From the journal</h2></div><a class="dusk-text-link" href="<%= theme.site.blog_url %>">All stories <span aria-hidden="true">↗</span></a></div><div class="dusk-cards"><% theme.recent_items.each_with_index do |item, index| %><article class="dusk-card"><% if theme_artwork? %><%= theme_picture %w[publishing customization foundation][index % 3], sizes: "(min-width: 58rem) 24vw, 100vw" %><% end %><% if item.published_at %><p class="dusk-kicker"><time datetime="<%= item.published_at %>"><%= item.published_at[0, 10] %></time></p><% end %><h3><a href="<%= item.url %>"><%= item.title %></a></h3><p><%= item.excerpt %></p></article><% end %></div></section><% end %></div></div>
