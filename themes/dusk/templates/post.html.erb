<div class="dusk-shell dusk-palette-<%= theme.options.fetch("palette", "afterglow") %> dusk-font-<%= theme.options.fetch("font", "system_serif") %> dusk-layout-<%= theme.options.fetch("layout", "studio") %>" data-dusk-family="post"><article class="dusk-wrap dusk-article"><header class="dusk-article-heading"><a class="dusk-text-link" href="<%= theme.site.blog_url %>">← Journal</a><p class="dusk-kicker"><% if theme.content.published_at %><time datetime="<%= theme.content.published_at %>"><%= theme.content.published_at[0, 10] %></time><% end %></p><h1><%= theme.content.title %></h1><p class="dusk-lede"><%= theme.content.excerpt %></p></header><%= theme_component "media" %><div class="dusk-prose"><%= theme.content.body_html %><%= theme.content.blocks_html %></div><footer class="dusk-article-footer"><a class="dusk-text-link" href="<%= theme.site.blog_url %>">Back to all stories <span aria-hidden="true">↗</span></a></footer></article></div>
