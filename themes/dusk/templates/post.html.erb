<div class="dusk-shell dusk-palette-<%= theme.options.fetch("palette", "afterglow") %> dusk-font-<%= theme.options.fetch("font", "system_serif") %> dusk-layout-<%= theme.options.fetch("layout", "studio") %>" data-dusk-family="post">
  <article class="dusk-wrap dusk-article">
    <header class="dusk-article-heading">
      <a class="dusk-text-link" href="<%= theme.site.blog_url %>"><span aria-hidden="true">←</span> All posts</a>
      <% if theme.content.published_at %>
        <p class="dusk-kicker"><time datetime="<%= theme.content.published_at %>"><%= theme.content.published_at[0, 10] %></time></p>
      <% end %>
      <h1><%= theme.content.title %></h1>
      <% unless theme.content.excerpt.empty? %><p class="dusk-lede"><%= theme.content.excerpt %></p><% end %>
    </header>
    <%= theme_component "media" %>
    <div class="dusk-prose"><%= theme_body_with_section_ids %><%= theme.content.blocks_html %></div>
  </article>
</div>
