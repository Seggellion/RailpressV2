<section class="dusk-shell dusk-palette-<%= theme.options.fetch("palette", "afterglow") %> dusk-font-<%= theme.options.fetch("font", "system_serif") %> dusk-layout-<%= theme.options.fetch("layout", "studio") %>" data-dusk-family="taxonomy">
  <div class="dusk-wrap dusk-list">
    <header class="dusk-list-heading">
      <a class="dusk-text-link" href="<%= theme.site.blog_url %>"><span aria-hidden="true">←</span> All posts</a>
      <h1><%= theme.archive_title %></h1>
    </header>
    <div class="dusk-cards">
      <% theme.items.each do |item| %>
        <article class="dusk-card">
          <%= item.featured_html %>
          <% if item.published_at %><p class="dusk-kicker"><time datetime="<%= item.published_at %>"><%= item.published_at[0, 10] %></time></p><% end %>
          <h2><a href="<%= item.url %>"><%= item.title %></a></h2>
          <% unless item.excerpt.empty? %><p><%= item.excerpt %></p><% end %>
        </article>
      <% end %>
    </div>
    <%= theme_component "pagination" %>
  </div>
</section>
