<%
documentation_tree = lambda do |items|
  has_current = false
  markup = items.map do |item|
    current = item.url == theme.content.url
    descendants, descendant_current = documentation_tree.call(item.children)
    has_current ||= current || descendant_current
    label = item.children.empty? ? item.label : "Overview: #{item.label}"
    link = link_to(label, item.url, aria: { current: ("page" if current) })
    if item.children.empty?
      tag.li { link }
    else
      tag.li do
        tag.details(class: "dusk-submenu", data: { disclosure: true }, open: current || descendant_current) do
          tag.summary(item.label) + tag.ul(class: "dusk-sub-list") { tag.li { link } + descendants }
        end
      end
    end
  end
  [safe_join(markup), has_current]
end
documentation, in_documentation = documentation_tree.call(theme.navigation.documentation)
%>
<div class="dusk-shell dusk-palette-<%= theme.options.fetch("palette", "afterglow") %> dusk-font-<%= theme.options.fetch("font", "system_serif") %> dusk-layout-<%= theme.options.fetch("layout", "studio") %>" data-dusk-family="page">
  <article class="dusk-wrap dusk-article<%= " dusk-article-with-docs" if in_documentation %>">
    <header class="dusk-article-heading">
      <h1><%= theme.content.title %></h1>
      <% unless theme.content.excerpt.empty? %><p class="dusk-lede"><%= theme.content.excerpt %></p><% end %>
    </header>
    <%= theme_component "media" %>
    <div class="dusk-article-content">
      <% if in_documentation %>
        <nav class="dusk-docs" aria-label="Documentation">
          <p class="dusk-kicker">In this section</p>
          <ul><%= documentation %></ul>
        </nav>
      <% end %>
      <div class="dusk-prose"><%= theme_body_with_section_ids %><%= theme.content.blocks_html %></div>
    </div>
  </article>
</div>
