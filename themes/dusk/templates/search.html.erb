<section class="dusk-shell dusk-palette-<%= theme.options.fetch("palette", "afterglow") %> dusk-font-<%= theme.options.fetch("font", "system_serif") %> dusk-layout-<%= theme.options.fetch("layout", "studio") %>" data-dusk-family="search">
  <div class="dusk-wrap dusk-list">
    <header class="dusk-list-heading">
      <h1>Search results</h1>
      <form class="dusk-search" action="<%= theme.site.search_url %>" method="get">
        <label for="dusk-query">Search this site</label>
        <div class="dusk-search-fields">
          <input id="dusk-query" name="q" type="search" value="<%= theme.query %>">
          <button type="submit">Search</button>
        </div>
      </form>
      <p>Results for “<%= theme.query %>”</p>
    </header>
    <div class="dusk-cards">
      <% theme.items.each do |item| %>
        <article class="dusk-card">
          <% if item.published_at %><p class="dusk-kicker"><time datetime="<%= item.published_at %>"><%= item.published_at[0, 10] %></time></p><% end %>
          <h2><a href="<%= item.url %>"><%= item.title %></a></h2>
          <% unless item.excerpt.empty? %><p><%= item.excerpt %></p><% end %>
        </article>
      <% end %>
    </div>
    <%= theme_component "pagination" %>
  </div>
</section>
