<section class="dusk-shell dusk-palette-<%= theme.options.fetch("palette", "afterglow") %> dusk-font-<%= theme.options.fetch("font", "system_serif") %> dusk-layout-<%= theme.options.fetch("layout", "studio") %>" data-dusk-family="search"><div class="dusk-wrap dusk-list"><header class="dusk-list-heading"><p class="dusk-kicker">Find your way</p><h1>Search</h1><form class="dusk-search" action="/search" method="get"><label for="dusk-query">Search this site</label><div class="dusk-search-fields"><input id="dusk-query" name="q" type="search" value="<%= theme.query %>"><button type="submit">Search</button></div></form><p>Results for “<%= theme.query %>”</p></header><div class="dusk-cards"><% theme.items.each do |item| %><article class="dusk-card"><p class="dusk-kicker">Journal<% if item.published_at %> · <time datetime="<%= item.published_at %>"><%= item.published_at[0, 10] %></time><% end %></p><h2><a href="<%= item.url %>"><%= item.title %></a></h2><p><%= item.excerpt %></p><a class="dusk-text-link" href="<%= item.url %>">Read <span class="dusk-sr-only"><%= item.title %></span><span aria-hidden="true"> ↗</span></a></article><% end %></div><%= theme_component "pagination" %></div></section>
