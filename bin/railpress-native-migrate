#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/railpress/native_scope"
require "digest"

version, name, digest = ARGV
abort "Invalid native migration request" unless ARGV.length == 3 && version.match?(/\A[1-9]\d{13}\z/) &&
  name.match?(%r{\Adb/migrate/#{version}_[a-z][a-z0-9_]*\.rb\z}) && digest.match?(/\A[0-9a-f]{64}\z/) &&
  ENV["RAILPRESS_NATIVE_TEST_PROFILE"] == "w03_bridge"
Railpress::NativeScope.verify!
path = File.join(File.dirname(ENV.fetch("BUNDLE_GEMFILE")), name)
stat = File.lstat(path)
abort "Native migration digest changed" unless stat.file? && !stat.symlink? && (stat.mode & 0o222).zero? &&
  Digest::SHA256.file(path).hexdigest == digest
Railpress::NativeScope.boot!
context = ActiveRecord::Base.connection_pool.migration_context
abort "Native migration already applied" if context.get_all_versions.include?(Integer(version, 10))
context.run(:up, Integer(version, 10))
abort "Native migration stamp missing" unless context.get_all_versions.include?(Integer(version, 10))
