<% content_for :title, "Import review · Railpress" %>
<%= javascript_include_tag "portability", defer: true %>
<p><%= link_to "Import / Export", admin_imports_path %></p><h1>Import review</h1>
<p>Archive <code><%= @batch.public_id %></code></p>
<p>Archive v3 carries the anonymous privacy policy. Applying source settings may change that policy and requires your explicit approval. Preserve destination settings to keep it. Older v2 archives leave the destination privacy policy unchanged; older readers cannot consume v3.</p>
<section class="admin-card" data-portability-status="<%= status_admin_import_path(@batch.public_id) %>" data-portability-state="<%= @batch.state %>">
<h2>Status</h2><p role="status" aria-live="polite" aria-atomic="true" data-portability-announcement><%= @batch.state.humanize %> · <%= @batch.progress %> of <%= @batch.total %> committed records.</p>
<% if @batch.total.positive? %><progress max="<%= @batch.total %>" value="<%= @batch.progress %>" aria-label="Committed import records"></progress><% end %>
<p><%= link_to "Refresh full review", admin_import_path(@batch.public_id) %></p>
<% if @batch.failure %><p role="alert"><strong>Stopped safely:</strong> <%= @batch.failure %>. Review conflicts and destination changes before explicitly retrying.</p><% end %>
<dl><dt>SHA-256</dt><dd><code><%= @batch.archive_sha256 %></code></dd><dt>Archive bytes</dt><dd><%= @batch.archive_bytes %></dd><dt>Format</dt><dd><%= @batch.format_version || "Awaiting validation" %></dd></dl></section>
<% if @batch.report["inventory"] %><section class="admin-card"><h2>Dry-run inventory</h2><dl class="dashboard-facts"><% @batch.report["inventory"].each do |key, value| %><div><dt><%= key.humanize %></dt><dd><%= value %></dd></div><% end %></dl><p>Media storage: <%= @batch.report["media_bytes"] %> bytes of approved variants. Allow additional temporary space for validation and canonical processing.</p><p>Source: <%= @batch.report["source_origin"] %><br>Destination: <%= @batch.report["destination_origin"] %></p><p><%= @batch.report["publication"] %></p><p>Theme reference compatible: <%= @batch.report["appearance_compatible"] ? "Yes" : "No; preserve the destination theme" %>.</p></section><% end %>
<% if @batch.state == "review" %>
<section class="admin-card"><h2>Resolve and approve private staging</h2>
<p>Every author, matching record and new path requires a deliberate choice. Matching never overwrites existing data. Staging does not publish, restore a schedule or enable an official news provider.</p>
<% if @batch.report["conflicts"].present? %><details open><summary>Conflicts and required decisions</summary><ul><% @batch.report["conflicts"].each do |conflict| %><li><strong><%= conflict["kind"].humanize %></strong>: <%= conflict["path"] || conflict["ref"] %>. <%= conflict["resolution"] %></li><% end %></ul></details><% end %>
<%= form_with url: approve_admin_import_path(@batch.public_id), data: {turbo: false} do %>
<%= hidden_field_tag :version, @batch.lock_version %>
<% @batch.manifest["authors"].each do |author| %><label for="author-<%= author['ref'] %>">Destination author for approved label “<%= author['label'] %>”</label><%= select_tag "decisions[authors][#{author['ref']}]", options_for_select(@authors), include_blank: "Choose explicitly", required: true, id: "author-#{author['ref']}" %><% end %>
<% @batch.manifest["content"].each do |record| %><fieldset><legend><%= record['working']['type'] %>: <%= record['working']['title'] %></legend><p>Historical state: <%= record['history']['state'] %>. Historical publication: <%= record['history']['published_at'] || "Unknown" %>. Destination: private draft.</p>
<% unless record['working']['author_ref'] %><label for="unassigned-<%= record['ref'] %>">Destination author (source attribution unassigned)</label><%= select_tag "decisions[unassigned][#{record['ref']}]", options_for_select(@authors), include_blank: "Choose explicitly", required: true, id: "unassigned-#{record['ref']}" %><% end %>
<label for="content-action-<%= record['ref'] %>">Identity decision</label><%= select_tag "decisions[content][#{record['ref']}][action]", options_for_select([["Create a new private record", "create"], ["Match verified unchanged prior import", "match"]]), id: "content-action-#{record['ref']}" %>
<label for="content-slug-<%= record['ref'] %>">Destination slug (new records only)</label><%= text_field_tag "decisions[content][#{record['ref']}][slug]", record['working']['slug'], maxlength: 160, required: true, id: "content-slug-#{record['ref']}" %>
<details><summary>Inspect escaped body, blocks and editorial metadata</summary><pre><%= record['working']['body'] %></pre><pre><%= JSON.pretty_generate(record['working'].slice('blocks', 'portable_metadata')) %></pre></details></fieldset><% end %>
<% @batch.manifest["terms"].each do |record| %><fieldset><legend><%= record['kind'].humanize %>: <%= record['name'] %></legend><label for="term-action-<%= record['ref'] %>">Taxonomy decision</label><%= select_tag "decisions[terms][#{record['ref']}][action]", options_for_select([["Create separately", "create"], ["Match identical existing taxonomy", "match"]]), id: "term-action-#{record['ref']}" %><label for="term-slug-<%= record['ref'] %>">New taxonomy slug</label><%= text_field_tag "decisions[terms][#{record['ref']}][slug]", record['slug'], maxlength: 160, id: "term-slug-#{record['ref']}" %><label for="term-match-<%= record['ref'] %>">Existing exact match (only for match decision)</label><%= select_tag "decisions[terms][#{record['ref']}][target_id]", options_for_select(Term.joins(:taxonomy).includes(:taxonomy).where(taxonomies: {kind: record['kind']}, name: record['name'], slug_key: Railpress::ContentRoutes.key(record['slug'])).order(:id).limit(2).map { |t| ["#{t.taxonomy.kind}: #{t.name} / #{t.slug}", t.id] }), include_blank: "No match", id: "term-match-#{record['ref']}" %></fieldset><% end %>
<% @batch.manifest["media"].each do |record| %><fieldset><legend>Media: <%= record['metadata']['title'] %></legend><p>Source permission: <%= record['rights']['license'] %> · <%= record['rights']['attribution'] %></p><label><%= check_box_tag "decisions[media][#{record['ref']}][rights_confirmed]", "1", false, required: true %> I have rechecked current destination rights for this object and variants</label><label for="media-action-<%= record['ref'] %>">Media decision</label><%= select_tag "decisions[media][#{record['ref']}][action]", options_for_select([["Validate and create privately", "create"], ["Match identical ready object", "match"]]), id: "media-action-#{record['ref']}" %><label for="media-match-<%= record['ref'] %>">Existing object (match decision only)</label><%= select_tag "decisions[media][#{record['ref']}][target_id]", options_for_select(MediaAsset.ready.order(:id).limit(1000).pluck(:title, :id)), include_blank: "No match", id: "media-match-#{record['ref']}" %></fieldset><% end %>
<label for="import-settings">Site identity decision</label><select id="import-settings" name="decisions[settings]"><option value="preserve_target">Preserve destination settings</option><option value="apply_nonsensitive">Stage nonsensitive identity for separate activation</option></select>
<label for="import-locations">Menu location decision</label><select id="import-locations" name="decisions[locations]"><option value="preserve_target">Preserve current placements; retain source assignments for review</option><option value="stage_unassigned">Stage menus unassigned; separately approve source placements</option></select>
<label for="import-appearance">Appearance decision</label><select id="import-appearance" name="decisions[appearance]"><option value="preserve_target">Preserve destination theme</option><option value="stage_compatible">Stage overlay for identical installed trusted theme</option></select>
<button>Approve private staging</button><% end %></section>
<%= button_to "Request a fresh dry run", inspect_archive_admin_import_path(@batch.public_id), params: {version: @batch.lock_version} %>
<% end %>
<% if @batch.state == "staged" %><section class="admin-card"><h2>Verified private staging</h2><p><%= @batch.report['reconciliation'] %>. Private drafts, scheduled and unreviewed source material cannot be activated here.</p>
<% if @batch.report['overlay_id'] %><%= button_to "Preview staged appearance in this session", preview_appearance_admin_import_path(@batch.public_id), params: {version: @batch.lock_version} %><% end %>
<%= form_with url: activate_admin_import_path(@batch.public_id), data: {turbo: false} do %><%= hidden_field_tag :version, @batch.lock_version %><% @batch.manifest['content'].each do |record| %><% if record['live'] && record['history']['state'] == 'published' && record['live']['visibility'] == 'public' && record['working']['portable_metadata'].fetch('review', {}).blank? %><label><%= check_box_tag 'content_refs[]', record['ref'], false %> Approve public activation: <%= record['live']['title'] %></label><% end %><% end %>
<label><%= check_box_tag :menus, '1', false %> Activate source live menu trees and reviewed location assignments</label><label><%= check_box_tag :settings, '1', false %> Apply previously approved nonsensitive settings (destination origin retained)</label><label><%= check_box_tag :appearance, '1', false %> Activate staged appearance after this session's preview</label><button>Approve separate activation</button><% end %></section><% end %>
<% if @batch.report['resume_state'] == 'receiving' %><section class="admin-card"><h2>Upload recovery</h2><% if @batch.report['upload_verified'] %><p>The verified upload did not finish promotion. Re-upload the exact same archive to reconcile this receipt; different bytes will be rejected.</p><%= form_with url: admin_imports_path, multipart: true, data: {turbo: false} do %><%= hidden_field_tag :idempotency_key, @batch.idempotency_key %><label for="recover-archive">Identical archive</label><%= file_field_tag :archive, id: 'recover-archive', required: true, accept: '.railpress' %><button>Recover verified upload</button><% end %><% else %><p>No complete transfer was verified. <%= link_to 'Start a new archive upload', admin_imports_path %>. This receipt remains in history; it cannot be staged.</p><% end %></section>
<% elsif %w[needs_approval blocked failed].include?(@batch.state) %><section class="admin-card"><h2>Recovery</h2><p>Retry verifies stored archive integrity and existing fingerprints. It does not erase a conflict or issue authority automatically.</p><%= button_to "Explicitly renew approval and reconcile", retry_admin_import_path(@batch.public_id), params: {version: @batch.lock_version} %></section><% end %>
<% if @reversal_reasons %><section class="admin-card"><h2>Reversal eligibility</h2><% if @reversal_reasons.any? %><ul><% @reversal_reasons.each do |reason| %><li><%= reason %></li><% end %></ul><p>Reversal is blocked. Existing matches, later edits and unrelated claims will not be deleted.</p><% else %><p>Only newly introduced unchanged records and owned unclaimed media are eligible. Matched destination records remain intact. Eligibility is checked again under the write lock.</p><%= button_to "Approve safe batch reversal", reverse_batch_admin_import_path(@batch.public_id), params: {version: @batch.lock_version} %><% end %></section><% end %>
<% if @batch.state == 'reversed' %><p>Reversal verified. Object cleanup: <%= @batch.report['object_cleanup'] %>.</p><%= button_to "Recheck owned object cleanup", cleanup_admin_import_path(@batch.public_id), params: {version: @batch.lock_version} %><% end %>
<section class="admin-card"><h2>Durable batch journal</h2><ol><% @batch.import_events.order(:number).limit(300).each do |event| %><li><%= event.number %>: <%= event.event.humanize %></li><% end %></ol></section>
