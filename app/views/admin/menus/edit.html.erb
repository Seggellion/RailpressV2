<% content_for :title, "#{@menu.name} · Navigation · Railpress" %>
<%= javascript_include_tag "menu_editor", defer: true %>
<div class="menu-page" data-menu-editor>
<div class="menu-heading"><div><p class="eyebrow">Site navigation / <%= @menu.status %></p><h1><%= @menu.name %></h1><p>Draft revision <%= @menu.lock_version %> · <%= @menu.published_revision_id ? "Published revision #{@menu.published_revision.number}" : "Not published" %></p></div><%= link_to "All menus", admin_menus_path %></div>
<% if response.status == 409 %><section class="menu-conflict" role="alert"><h2>Another editor saved first.</h2><p>The current server tree appears below. Your submitted tree is retained for comparison; nothing was overwritten.</p><p><%= link_to "Reload current menu", edit_admin_menu_path(@menu) %></p><details><summary>Compare your submitted tree</summary><pre><%= @submitted.presence || params.except(:authenticity_token, :controller, :action).to_unsafe_h.to_json %></pre></details></section><% end %>
<p id="menu-announcement" class="hint" role="status" aria-live="polite">Changes save to the server. Publish when your draft is ready.</p>
<% if @menu.status == "active" %>
<div class="menu-workspace">
<aside class="menu-sources menu-card" aria-label="Add menu items"><h2>Add to menu</h2><p class="hint">Published public content only. Typed links follow future URL changes.</p>
<%= form_with url: edit_admin_menu_path(@menu), method: :get, data: { turbo: false } do |form| %><%= label_tag :source_query, "Find content or topics" %><%= search_field_tag :source_query, @source_query, maxlength: 160 %><%= form.button "Find content" %><% end %><p class="hint">Up to 200 matching results. Refine your search for larger sites.</p>
<% [["Page", "Pages"], ["Post", "Posts"]].each do |kind, title| %>
<details open><summary><%= title %></summary>
<%= form_with url: admin_menu_path(@menu), method: :patch, data: { turbo: false } do |form| %>
<%= hidden_field_tag :operation, "add", id: nil %><%= hidden_field_tag :version, @menu.lock_version, id: nil %><%= hidden_field_tag :state_version, @state_version, id: nil %>
<%= label_tag "source_#{kind}", "Choose a #{kind.downcase}" %><%= select_tag :target, options_for_select(@sources.select { |record| record.type == kind }.map { |record| [record.published_snapshot.fetch("title"), "#{kind}:#{record.id}"] }), id: "source_#{kind}", include_blank: "Select published content", required: true %>
<%= form.button "Add #{kind.downcase}" %><% end %></details><% end %>
<details><summary>Categories and tags</summary><%= form_with url: admin_menu_path(@menu), method: :patch, data: { turbo: false } do |form| %><%= hidden_field_tag :operation, "add", id: nil %><%= hidden_field_tag :version, @menu.lock_version, id: nil %><%= hidden_field_tag :state_version, @state_version, id: nil %><%= label_tag :source_term, "Choose a topic" %><%= select_tag :target, options_for_select(@terms.map { |term| ["#{term.name} (#{term.taxonomy.kind})", "Term:#{term.id}"] }), id: "source_term", include_blank: "Select a topic", required: true %><%= form.button "Add topic" %><% end %></details>
<details><summary>Custom link</summary><%= form_with url: admin_menu_path(@menu), method: :patch, data: { turbo: false } do |form| %><%= hidden_field_tag :operation, "add", id: nil %><%= hidden_field_tag :version, @menu.lock_version, id: nil %><%= hidden_field_tag :state_version, @state_version, id: nil %><%= hidden_field_tag "item[kind]", "Custom", id: nil %><%= label_tag :custom_label, "Link text" %><%= text_field_tag "item[label]", nil, id: "custom_label", maxlength: 120, required: true %><%= label_tag :custom_url, "Destination" %><%= text_field_tag "item[url]", nil, id: "custom_url", maxlength: 2048, required: true, placeholder: "/search or https://example.com" %><p class="hint">Local public paths or HTTPS. No scripts, credentials or remote fetching.</p><%= form.button "Add custom link" %><% end %></details>
</aside>
<section class="menu-canvas menu-card" aria-labelledby="tree-heading"><h2 id="tree-heading">Menu structure</h2><p class="hint" id="tree-help">Drag a handle onto another item to place it before that item. Use Up, Down, Indent and Outdent for the same saved tree, including nested organization. Maximum 3 levels; 30 items.</p>
<%= form_with url: admin_menu_path(@menu), method: :patch, id: "menu-reorder", data: { turbo: false } do %><%= hidden_field_tag :operation, "reorder", id: nil %><%= hidden_field_tag :version, @menu.lock_version, id: nil %><%= hidden_field_tag :state_version, @state_version, id: nil %><%= hidden_field_tag :tree, "", id: "menu-tree-payload" %><% end %>
<% if @rows.empty? %><div class="menu-empty"><h3>Your draft is a blank canvas.</h3><p>Choose content in the panel to add your first link. Nothing is published yet.</p></div><% end %>
<ol class="menu-tree" aria-describedby="tree-help"><% @rows.each do |row| %>
<% depth = 0; ancestor = row["parent_key"]; while ancestor; depth += 1; ancestor = @rows.find { |item| item["key"] == ancestor }&.fetch("parent_key"); end %>
<li class="menu-node menu-depth-<%= depth %>" data-item-key="<%= row["key"] %>" data-parent-key="<%= row["parent_key"] %>" data-position="<%= row["position"] %>">
<div class="menu-node-heading"><button type="button" class="menu-drag" draggable="true" aria-label="Drag <%= row["label"] %>" title="Drag before another item">⠿</button><strong><%= row["label"] %></strong><span class="menu-type"><%= row["kind"] %> · level <%= depth + 1 %></span></div>
<div class="menu-drop-inside" data-drop-inside>Drop inside <%= row["label"] %></div>
<div class="menu-moves"><% %w[up down indent outdent].each do |direction| %><%= button_to direction.capitalize, admin_menu_path(@menu), method: :patch, params: { operation: "move", key: row["key"], direction: direction, version: @menu.lock_version, state_version: @state_version }, form: { data: { turbo: false } }, aria: { label: "#{direction.capitalize} #{row['label']}" } %><% end %></div>
<details><summary>Edit <%= row["label"] %></summary>
<%= form_with url: admin_menu_path(@menu), method: :patch, data: { turbo: false } do |form| %><%= hidden_field_tag :operation, "update", id: nil %><%= hidden_field_tag :key, row["key"], id: nil %><%= hidden_field_tag :version, @menu.lock_version, id: nil %><%= hidden_field_tag :state_version, @state_version, id: nil %><%= label_tag "label_#{row['key']}", "Navigation label" %><%= text_field_tag "item[label]", row["label"], id: "label_#{row['key']}", required: true, maxlength: 120 %>
<% if row["kind"] == "Custom" %><%= hidden_field_tag "item[kind]", "Custom", id: nil %><%= label_tag "url_#{row['key']}", "Destination" %><%= text_field_tag "item[url]", row["url"], id: "url_#{row['key']}", required: true, maxlength: 2048 %><% else %><p class="hint">Typed <%= row["kind"] %> target. Its public URL resolves automatically; hidden targets and their children are omitted.</p><% end %><%= form.button "Save item" %><% end %>
<%= button_to "Remove item and descendants", admin_menu_path(@menu), method: :patch, params: { operation: "remove", key: row["key"], version: @menu.lock_version, state_version: @state_version }, form: { data: { turbo: false } } %></details>
</li><% end %></ol></section></div>
<section class="menu-card"><h2>Theme locations</h2><p>Locations belong to themes, independently of menu names. Assignment changes stay draft until this menu is published. Selecting an occupied location explicitly replaces its draft assignment.</p>
<%= form_with url: admin_menu_path(@menu), method: :patch, data: { turbo: false } do |form| %><%= hidden_field_tag :operation, "assign", id: nil %><%= hidden_field_tag :version, @menu.lock_version, id: nil %><%= hidden_field_tag :state_version, @state_version, id: nil %><%= hidden_field_tag "locations[]", "", id: nil %>
<% if @locations.empty? %><p>No trusted theme declares menu locations yet. Your menu can be prepared now.</p><% end %>
<% @locations.each do |key, label| %><label class="checkbox"><%= check_box_tag "locations[]", key, @assigned.include?(key), id: "menu_location_#{key.tr(':', '_')}" %><span><%= label %> <small>(<%= key %>)</small></span></label><% end %><%= form.button "Save draft locations" %><% end %></section>
<section class="menu-card menu-publish"><h2>Ready to guide your visitors?</h2><p>Preview uses your current signed-in session only. Publishing switches this tree and its locations in one transaction.</p><div class="menu-actions"><%= button_to "Preview draft", preview_admin_menu_path(@menu), form: { data: { turbo: false } }, disabled: @assigned.empty? || !ThemeState.find_by(site: @site)&.active_installation_id %><%= button_to "Publish navigation", admin_menu_path(@menu), method: :patch, params: { operation: "publish", version: @menu.lock_version, state_version: @state_version }, form: { data: { turbo: false } } %></div></section>
<details class="menu-card"><summary>Menu settings</summary><%= form_with url: admin_menu_path(@menu), method: :patch, data: { turbo: false } do |form| %><%= hidden_field_tag :operation, "rename", id: nil %><%= hidden_field_tag :version, @menu.lock_version, id: nil %><%= hidden_field_tag :state_version, @state_version, id: nil %><%= label_tag :menu_name, "Menu name" %><%= text_field_tag :name, @menu.name, id: "menu_name", required: true, maxlength: 100 %><%= form.button "Rename menu" %><% end %><%= button_to "Withdraw menu", admin_menu_path(@menu), method: :delete, params: { version: @menu.lock_version, state_version: @state_version }, form: { data: { turbo: false } } %></details>
<% end %>
<section class="menu-card"><h2>History and recovery</h2><p>Undo restores the last server-confirmed menu and assignment state, including publication. It refuses to overwrite a later change to any menu.</p>
<% if @latest %><p>Last change: <%= @latest.operation %> · revision <%= @latest.number %></p><%= button_to "Undo last change", admin_menu_path(@menu), method: :patch, params: { operation: "undo", revision_id: @latest.id, version: @menu.lock_version, state_version: @state_version }, form: { data: { turbo: false } }, disabled: @latest.state_version != @state_version %><details><summary>Recent revisions</summary><ol><% @menu.menu_revisions.order(number: :desc).limit(20).each do |revision| %><li>Revision <%= revision.number %> · <%= revision.operation %> · <%= revision.actor.username %></li><% end %></ol></details><% end %></section>
</div>
