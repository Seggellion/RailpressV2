<h1>SEO correctness</h1>
<%= render "navigation" %>
<dl>
  <dt>Canonical origin</dt><dd><%= @site.canonical_origin %></dd>
  <dt>Effective indexing policy</dt><dd><%= @policy.reason.humanize %></dd>
  <dt>Site indexing switch</dt><dd><%= @site.indexing_enabled? ? "Enabled" : "Disabled" %></dd>
  <dt>Operator indexing override</dt><dd><%= Seo::Diagnostics.operator_indexing_disabled? ? "Indexing disabled" : "Site policy applies" %></dd>
  <dt>HTTPS redirect origin</dt><dd><%= ENV.fetch("RAILPRESS_HTTPS_ORIGIN", "https://localhost") %></dd>
  <dt>Latest diagnostic</dt>
  <dd><%= @latest ? link_to(seo_run_status(@latest), admin_seo_diagnostic_path(@latest)) : seo_run_status(nil) %></dd>
  <dt>Last clean result</dt>
  <dd><%= @last_clean ? link_to(@last_clean.finished_at.iso8601, admin_seo_diagnostic_path(@last_clean)) : "None recorded" %></dd>
</dl>
<p>Google indexing, ranking and crawling are unknown to these checks.</p>
<p><%= link_to "Edit site settings", admin_settings_path %></p>
