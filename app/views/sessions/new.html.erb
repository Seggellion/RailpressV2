<% content_for :title, "Sign in · Railpress" %>
<p class="eyebrow">Welcome back</p>
<h1>Sign in to your site.</h1>
<%= form_with url: login_path, data: { turbo: false } do |form| %>
  <%= form.label :identifier, "Username or email" %>
  <%= form.text_field :identifier, required: true, autocomplete: "username", maxlength: 254 %>
  <%= form.label :password, "Password" %>
  <%= form.password_field :password, required: true, autocomplete: "current-password" %>
  <%= form.submit "Sign in" %>
<% end %>
<nav aria-label="Account recovery"><%= link_to "Request password recovery", password_recovery_path %> · <%= link_to "Reset a password", password_reset_path %></nav>
